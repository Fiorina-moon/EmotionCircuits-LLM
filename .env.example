# 复制为 .env 后填写；.env 已在 .gitignore 中排除
# Copy to .env and fill in; .env is git-ignored
#
# 文本打标渠道的 API key（阶段 01/03/07 的 label_* 脚本）
# 渠道地址与模型在 config.yaml 的 labeling 段配置
LABEL_API_KEY=
#
# 可选覆盖（一般不需要）
# LABEL_BASE_URL=https://llmapi.paratera.com/v1
# LABEL_MODEL=Qwen3.5-397B-A17B
#
# 仅在使用远程 HuggingFace 模型时需要（本地模型不会联网）
HF_TOKEN=
#
# 兼容回退：未设置 LABEL_API_KEY 时会读取 OPENAI_API_KEY
# OPENAI_API_KEY=
